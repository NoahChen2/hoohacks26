# Server only. Never prefix these with VITE_. Leave both GEMINI_API_KEY and
# OPENAI_API_KEY empty for DEMO MODE. Gemini is used first when it is set.
OPENAI_API_KEY=
# Set to a vision-capable model supporting Responses structured outputs.
OPENAI_VISION_MODEL=

# Clothing photo scan (closet + AI Studio upload) and AI Studio analysis use
# Google Gemini when set.
# Get a free key at https://aistudio.google.com/apikey (Gemini API free tier).
# On the free tier Google may use submitted photos to improve its products.
GEMINI_API_KEY=
# Optional model to try first. By default the scan uses gemini-3.8-flash, then
# gemini-3.5-flash-lite and gemini-flash-latest when a free quota is used up.
GEMINI_MODEL=

# Optional production Node server port (npm run build && npm start)
PORT=3000

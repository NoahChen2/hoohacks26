{
  "name": "restitch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/explore src/studio src/tutorial src/learn src/entry.js server vite.config.js tests/*.test.mjs tests/fixtures scripts/generate-explore-assets.mjs scripts/generate-post-seed.mjs supabase/seed-posts.mjs",
    "start": "node server/index.js",
    "seed:sql": "node scripts/generate-post-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide": "^1.59.0",
    "openai": "^7.38.0",
    "three": "^0.169.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10"
  }
}
